    {
      "name": "edit_glyph_nodes",
      "description": "Edit indexed contour points.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "dry_run": {
            "type": "boolean"
          },
          "font_id": {
            "type": "number"
          },
          "font_name": {
            "type": "string"
          },
          "glyph_name": {
            "type": "string"
          },
          "layer_name": {
            "type": "string"
          },
          "operations": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "axis": {
                  "enum": [
                    "x",
                    "y"
                  ],
                  "type": "string"
                },
                "centered": {
                  "type": "boolean"
                },
                "contour_index": {
                  "type": "integer"
                },
                "distance": {
                  "type": "number"
                },
                "dx": {
                  "type": "number"
                },
                "dy": {
                  "type": "number"
                },
                "matrix": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 6,
                  "minItems": 6,
                  "type": "array"
                },
                "move_handles": {
                  "type": "boolean"
                },
                "node_index": {
                  "type": "integer"
                },
                "node_indices": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                "op": {
                  "enum": [
                    "add",
                    "delete",
                    "set",
                    "move",
                    "duplicate",
                    "duplicate_extrema",
                    "split",
                    "transform",
                    "reverse"
                  ],
                  "type": "string"
                },
                "shape_index": {
                  "type": "integer"
                },
                "smooth": {
                  "type": "boolean"
                },
                "t": {
                  "type": "number"
                },
                "type": {
                  "enum": [
                    "on",
                    "off",
                    "curve"
                  ],
                  "type": "string"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "op",
                "shape_index",
                "contour_index"
              ],
              "type": "object"
            },
            "maxItems": 256,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "glyph_name",
          "operations"
        ],
        "type": "object"
      }
